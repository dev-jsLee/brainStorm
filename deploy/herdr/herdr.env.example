# brainStorm herdr 어댑터 설정 — 비밀 없음. 토큰은 별도 600 파일.
# (EnvironmentFile 은 %h 를 풀지 않는다 — /home/you 를 실제 홈으로 고친다)
# 자리: ~/.config/brainstorm/herdr-<이름>.env  (유닛 brainstorm-agent-herdr@<이름>.service 가 읽는다)
BRAINSTORM_URL=http://127.0.0.1:8080
BRAINSTORM_TOKEN_FILE=/home/you/.config/brainstorm/herdr-NAME.token
# 붙일 창: herdr session list → herdr --session <세션> agent list 의 pane_id(또는 agent 이름)
HERDR_SESSION=SESSION
HERDR_PANE=w1:p1
# 창 제목으로 찾으려면 HERDR_PANE 을 지우고(정확히 같은 제목 하나)
#HERDR_PANE_TITLE=
#HERDR_BIN=/home/you/.local/bin/herdr
# 한 턴 최대 · claim 뒤 창이 바쁠 때 기다리는 최대 · 주입한 글이 세션 기록에 나타나기를 기다리는 최대
HERDR_TIMEOUT_MS=1800000
HERDR_BUSY_WAIT_MS=600000
HERDR_ACCEPT_MS=30000
