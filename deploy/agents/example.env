# /etc/brainstorm/agents/<이름>.env — OpenAI 호환 어댑터 설정. 비밀을 넣지 않는다(토큰·키는 별도 600 파일).
# 칸 설명: node /opt/brainstorm/dist/adapter/openai-adapter.js --help

# brainStorm 서버 (같은 CT 에서 돌면 127.0.0.1)
BRAINSTORM_URL=http://127.0.0.1:8080

# OpenAI 호환 서버 — /chat/completions 앞까지 (끝에 /v1)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# 서버가 아는 모델 이름 (확인: openai-adapter.js check)
OPENAI_MODEL=model-name

# 모델 컨텍스트 크기와 답 최대 토큰 — 맥락은 (컨텍스트 - 답 - 시스템 프롬프트 - 여유) 안에 최근 글부터 채운다
OPENAI_CONTEXT_TOKENS=32768
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_MS=600000
#OPENAI_TEMPERATURE=0.7
#OPENAI_STREAM=0

# 시스템 프롬프트(선택). 파일이 있으면 그것, 없으면 기본 문구
#OPENAI_SYSTEM_PROMPT_FILE=/etc/brainstorm/agents/<이름>.prompt

#BRAINSTORM_POLL_MS=1500
#BRAINSTORM_HEARTBEAT_MS=5000
