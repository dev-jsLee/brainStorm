# /etc/brainstorm/brainstorm.env — brainStorm 설정 (비밀 없음. 비밀은 DB에 해시로만)
BRAINSTORM_DATA_DIR=/var/lib/brainstorm
# 첫 주소가 주 리스너. LAN은 평문 HTTP (Tailscale/HTTPS 는 나중)
BRAINSTORM_LISTEN=127.0.0.1:8080
# LAN 에도 열려면 쉼표로 더한다: 127.0.0.1:8080,192.0.2.10:8080
# 쿠키 인증 상태 변경 요청과 WebSocket 이 허용하는 Origin
BRAINSTORM_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# auto = 요청이 https 일 때만 Secure 쿠키
BRAINSTORM_SECURE_COOKIE=auto
BRAINSTORM_LOG_LEVEL=info
# 크기 제한
BRAINSTORM_BODY_MAX_CHARS=32000
BRAINSTORM_ATTACHMENT_MAX_BYTES=20971520
# 전달·실행 lease
BRAINSTORM_DELIVERY_LEASE_MS=30000
BRAINSTORM_RUN_LEASE_MS=60000
# 실행 중 취소 요청 뒤 어댑터 중단 확인을 기다리는 시간. 넘으면 실행은 unknown(자동 재실행 없음)
BRAINSTORM_CANCEL_ACK_MS=30000
BRAINSTORM_DEFAULT_CALL_BUDGET=3
BRAINSTORM_MAX_CALL_BUDGET=10
# 대면 모드 — 초안 쪽 · 검토 쪽 에이전트 id(비우면 대면 모드 꺼짐) · 기본 턴 · 상한 턴
BRAINSTORM_FACE_DRAFTER=
BRAINSTORM_FACE_REVIEWER=
BRAINSTORM_FACE_BASE_TURNS=4
BRAINSTORM_FACE_MAX_TURNS=6
