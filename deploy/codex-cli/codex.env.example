# brainStorm Codex 어댑터(codex exec) 설정 — 비밀 없음. 토큰은 별도 600 파일.
# (EnvironmentFile 은 %h 를 풀지 않는다 — /home/you 를 실제 홈으로 고친다)
# 자리: ~/.config/brainstorm/codex.env  (유닛 brainstorm-agent-codex.service 가 읽는다)
BRAINSTORM_URL=http://127.0.0.1:8080
BRAINSTORM_TOKEN_FILE=/home/you/.config/brainstorm/codex.token
BRAINSTORM_WORKER=codex-host
CODEX_BIN=codex
CODEX_CWD=/home/you/workspace
# 권한: exec 앞 인자. 예) 읽기 전용 샌드박스 · 승인 묻지 않음
CODEX_ARGS="--sandbox read-only --ask-for-approval never"
CODEX_TIMEOUT_MS=1800000
