# brainStorm Claude Code 어댑터(claude -p) 설정 — 비밀 없음. 토큰은 별도 600 파일.
# (EnvironmentFile 은 %h 를 풀지 않는다 — /home/you 를 실제 홈으로 고친다)
# 자리: ~/.config/brainstorm/claude.env  (유닛 brainstorm-agent-claude.service 가 읽는다)
BRAINSTORM_URL=http://127.0.0.1:8080
BRAINSTORM_TOKEN_FILE=/home/you/.config/brainstorm/claude.token
BRAINSTORM_WORKER=claude-host
CLAUDE_BIN=claude
CLAUDE_CWD=/home/you/workspace
# 권한은 코드에 박지 않는다 — 필요한 만큼만 연다(예: --permission-mode acceptEdits)
#CLAUDE_EXTRA_ARGS=
CLAUDE_TIMEOUT_MS=1800000
# 명시적 참조: 글의 태그(#서버) → 이 폴더의 같은 이름 노트 본문을 붙인다(없으면 끔)
#CLAUDE_REFS_DIR=
