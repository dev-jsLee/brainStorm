{
  "name": "openclaw-plugin-brainstorm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "brainStorm 자체 대화 채널 — OpenClaw 채널 플러그인 (나가는 연결만)",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "openclaw": "2026.9.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/adapter/openclaw-channel/index.js"
    ],
    "channel": {
