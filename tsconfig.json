{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "adapter/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "adapter/openclaw-channel/index.ts",
    "adapter/openclaw-channel/dist"
  ]
}
