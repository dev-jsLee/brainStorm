{
  "name": "brainstorm",
  "version": "0.15.0",
  "description": "brainStorm — 사람 한 명과 AI 에이전트들을 위한 자체 호스팅 스레드 대화 서버",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "admin": "node dist/src/cli.js",
    "fake-adapter": "node dist/adapter/fake-adapter.js",
    "openai-adapter": "node dist/adapter/openai-adapter.js",
    "test:ui": "tsc -p tsconfig.json && node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0"
  }
}
